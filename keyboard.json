{
    "keyboard_name": "EKBOX",
    "maintainer": "ergokeeb",
    "manufacturer": "ergokeeb",
    "url": "https://github.com/ergokeeb/ekbox",
    "usb": {
        "vid": "0x4653",
        "pid": "0x0004",
        "device_version": "1.1.0",
        "suspend_wakeup_delay": 200
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "backlight": true,
        "bootmagic": true,
        "extrakey": true,
        "nkro": true,
        "oled": true
        //"rgblight": false,
        //"rgb_matrix": true,
        //"mousekey": true
        //"encoder": true
    },
    "diode_direction": "COL2ROW",
    "dynamic_keymap": {
        "layer_count": 8
    },
    "matrix_pins": {
            "cols": ["GP22","GP26","GP27","GP28","GP29"],
            "rows": ["GP5" ,"GP6", "GP7", "GP8"]          
    },
    "bootmagic": {
        "enabled": true,
        "matrix": [ 0, 1 ]
    },
    "backlight": {
        "pin": "GP10",
        "levels": 5
    },
    "split": {
        "enabled": true,
        "bootmagic": {
            "matrix": [ 4, 1 ]
        },
        "matrix_pins": {
            "right": {
                "cols": ["GP22","GP26","GP27","GP28","GP29"],
                "rows": ["GP5" ,"GP6", "GP7", "GP8"]
            }
        },
        "serial": {
            "driver": "vendor"
        },
        "transport": {
            "sync": {
                "matrix_state": true,
                "modifiers": true
            },
            "watchdog": true
        }
    },
    "community_layouts": ["split_3x5_3"],
    "layouts": {
        "LAYOUT_split_3x5_3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0.3},
                {"matrix": [0, 1], "x": 1, "y": 0.3},
                {"matrix": [0, 2], "x": 2, "y": 0.1},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [0, 4], "x": 4, "y": 0.1},

                {"matrix": [4, 4], "x": 10, "y": 0.1},
                {"matrix": [4, 3], "x": 11, "y": 0},
                {"matrix": [4, 2], "x": 12, "y": 0.1},
                {"matrix": [4, 1], "x": 13, "y": 0.3},
                {"matrix": [4, 0], "x": 14, "y": 0.3},

                {"matrix": [1, 0], "x": 0, "y": 1.3},
                {"matrix": [1, 1], "x": 1, "y": 1.3},
                {"matrix": [1, 2], "x": 2, "y": 1.1},
                {"matrix": [1, 3], "x": 3, "y": 1},
                {"matrix": [1, 4], "x": 4, "y": 1.1},

                {"matrix": [5, 4], "x": 10, "y": 1.1},
                {"matrix": [5, 3], "x": 11, "y": 1},
                {"matrix": [5, 2], "x": 12, "y": 1.1},
                {"matrix": [5, 1], "x": 13, "y": 1.3},
                {"matrix": [5, 0], "x": 14, "y": 1.3},

                {"matrix": [2, 0], "x": 0, "y": 2.3},
                {"matrix": [2, 1], "x": 1, "y": 2.3},
                {"matrix": [2, 2], "x": 2, "y": 2.1},
                {"matrix": [2, 3], "x": 3, "y": 2},
                {"matrix": [2, 4], "x": 4, "y": 2.1},
                
                {"matrix": [6, 4], "x": 10, "y": 2.1},
                {"matrix": [6, 3], "x": 11, "y": 2},
                {"matrix": [6, 2], "x": 12, "y": 2.1},
                {"matrix": [6, 1], "x": 13, "y": 2.3},
                {"matrix": [6, 0], "x": 14, "y": 2.3},

                {"matrix": [3, 2], "x": 4, "y": 3.7},
                {"matrix": [3, 3], "x": 5, "y": 3.7},
                {"matrix": [3, 4], "x": 6, "y": 3.2, "h": 1.5},

                {"matrix": [7, 4], "x": 8, "y": 3.2, "h": 1.5},
                {"matrix": [7, 3], "x": 9, "y": 3.7},
                {"matrix": [7, 2], "x": 10, "y": 3.7}
            ]
        }
    }
}

